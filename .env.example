# Ajuste esses caminhos conforme sua máquina

ISAAC_SIM_PATH=/caminho/para/isaacsim
PEGASUS_PATH=/caminho/para/PegasusSimulator
PX4_PATH=/caminho/para/PX4-Autopilot
ROS_WS_PATH=./ros2_ws

# Opcional
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Agente LVLM (OpenAI-compatible)
# LVLM_API_KEY=sk-...
# LVLM_API_BASE=https://api.openai.com/v1
# LVLM_MODEL=gpt-4o-mini

# Voice listener (Whisper local)
# VOICE_STT_BACKEND=local
# VOICE_MODEL_SIZE=small
# VOICE_LANGUAGE=pt
# VOICE_RECORD_SECONDS=5.0
# VOICE_CONFIRM_BEFORE_PUBLISH=true
# VOICE_WHISPER_DEVICE=cpu
# VOICE_COMPUTE_TYPE=int8

# Voice listener com OpenAI transcription API
# OPENAI_API_KEY=sk-...
# VOICE_STT_BACKEND=openai
# VOICE_OPENAI_MODEL=gpt-4o-mini-transcribe
# VOICE_OPENAI_API_BASE=https://api.openai.com/v1
